{
  "schema": 1,
  "source": "apps/stage/tests/fixtures/front-door-vectors.json (rows D and P and X01), vendored for the kernel pairing flow (P3b S8). Each row keeps its Stage id. Rows that test the Stage's own HTTP surface (cookies, /r/{key} paths, loopback /local) are not vendored; their kernel equivalents are in serve_pairing_test.go.",
  "format": {
    "step": "{op: request|poll|approve|deny|age|list|prop, ref/secret/auth/body/repeat, save: {VAR: json field}, expect}",
    "ref": "request id or code, {VAR} substituted from saves",
    "secret": "{VAR} or the literal 'wrong'",
    "auth": "grant | grant_noscope | link_device | link_noscope | none | bogus",
    "expect": "status, error (message text), json_subset, json_keys, json_regex, json_ne"
  },
  "rows": [
    {"id": "P01", "stage": "POST /pair: code, secret, expires_s=600; 4 letters from the alphabet",
     "steps": [{"op": "request", "body": {"kind": "share", "name": "vector screen"},
       "expect": {"status": 200, "json_keys": ["id", "code", "secret", "expires_s"], "json_subset": {"expires_s": 600, "kind": "share"}, "json_regex": {"code": "^[BCDFGHJKLMNPQRSTVWXZ]{4}$"}}}]},
    {"id": "D01", "stage": "POST /device/request: 6 letters, 600 s, name recorded; the token travels only in the poll, never here",
     "steps": [{"op": "request", "body": {"kind": "device", "name": "vector screen"},
       "expect": {"status": 200, "json_keys": ["code", "secret"], "json_subset": {"expires_s": 600, "kind": "device"}, "json_regex": {"code": "^[BCDFGHJKLMNPQRSTVWXZ]{6}$"}}}]},
    {"id": "D08", "stage": "50 open then busy (device)",
     "steps": [{"op": "request", "body": {"kind": "device", "name": "x"}, "repeat": 50, "expect": {"status": 200}},
               {"op": "request", "body": {"kind": "device", "name": "x"}, "expect": {"status": 429, "error": "busy"}}]},
    {"id": "P02", "stage": "50 open then busy (share)",
     "steps": [{"op": "request", "body": {"kind": "share"}, "repeat": 50, "expect": {"status": 200}},
               {"op": "request", "body": {"kind": "share"}, "expect": {"status": 429, "error": "busy"}}]},
    {"id": "D09", "stage": "a code older than 600 s no longer approves",
     "steps": [{"op": "request", "body": {"kind": "device", "name": "x"}, "expect": {"status": 200}, "save": {"C1": "code"}},
               {"op": "age", "seconds": 601},
               {"op": "approve", "ref": "{C1}", "auth": "grant", "body": {"actor": "chaz", "role": "owner"}, "expect": {"status": 404, "error": "no such code (expired?)"}}]},
    {"id": "P05", "stage": "wrong secret is the same 404 as an unknown code",
     "steps": [{"op": "request", "body": {"kind": "share"}, "expect": {"status": 200}, "save": {"PC": "code"}},
               {"op": "poll", "ref": "{PC}", "secret": "wrong", "expect": {"status": 404, "error": "unknown code"}}]},
    {"id": "P06", "stage": "an unapproved poll answers 202 pending after the wait",
     "steps": [{"op": "request", "body": {"kind": "share"}, "expect": {"status": 200}, "save": {"PC": "code", "PS": "secret"}},
               {"op": "poll", "ref": "{PC}", "secret": "{PS}", "expect": {"status": 202, "json_subset": {"pending": true}}}]},
    {"id": "P07", "stage": "the approved poll returns the credential once, the next poll is unknown",
     "steps": [{"op": "request", "body": {"kind": "share"}, "expect": {"status": 200}, "save": {"PC": "code", "PS": "secret"}},
               {"op": "approve", "ref": "{PC}", "auth": "grant", "body": {"surface": "stage/room/fdvshared/member/vroku", "actor": "vroku", "role": "guest", "room": "fdvshared", "scope": ["stage:room:fdvshared"]},
                "expect": {"status": 200, "json_subset": {"approved": true}}},
               {"op": "poll", "ref": "{PC}", "secret": "{PS}", "expect": {"status": 200, "json_subset": {"status": "approved", "kind": "share"}, "json_keys": ["token", "link"]}},
               {"op": "poll", "ref": "{PC}", "secret": "{PS}", "expect": {"status": 404, "error": "unknown code"}}]},
    {"id": "P07b", "stage": "approval for the owner (default person) binds the room",
     "steps": [{"op": "request", "body": {"kind": "share"}, "expect": {"status": 200}, "save": {"PC": "code", "PS": "secret"}},
               {"op": "approve", "ref": "{PC}", "auth": "grant", "body": {"surface": "stage/room/fdvshared/owner", "actor": "chaz", "role": "owner", "room": "fdvshared", "scope": ["stage:room:fdvshared"]}, "expect": {"status": 200}},
               {"op": "poll", "ref": "{PC}", "secret": "{PS}", "expect": {"status": 200, "json_subset": {"link": {"room": "fdvshared", "actor": "chaz"}}}}]},
    {"id": "D14", "stage": "device approval: the requester receives a device link",
     "steps": [{"op": "request", "body": {"kind": "device", "name": "x"}, "expect": {"status": 200}, "save": {"C1": "code", "S1": "secret"}},
               {"op": "approve", "ref": "{C1}", "auth": "grant", "body": {"actor": "chaz", "role": "owner"}, "expect": {"status": 200, "json_subset": {"approved": true}}},
               {"op": "poll", "ref": "{C1}", "secret": "{S1}", "expect": {"status": 200, "json_subset": {"status": "approved", "kind": "device"}, "json_keys": ["token"]}}]},
    {"id": "D15", "stage": "P04: an approval from nobody is refused (kernel: 401 for no credential, not 'not local')",
     "steps": [{"op": "request", "body": {"kind": "device"}, "expect": {"status": 200}, "save": {"C1": "code"}},
               {"op": "approve", "ref": "{C1}", "auth": "none", "body": {"actor": "chaz", "role": "owner"}, "expect": {"status": 401}},
               {"op": "approve", "ref": "{C1}", "auth": "bogus", "body": {"actor": "chaz", "role": "owner"}, "expect": {"status": 401}}]},
    {"id": "X-approve-403", "stage": "plan S8 gate: an approval presented with a share link that lacks pairing:approve gets 403",
     "steps": [{"op": "request", "body": {"kind": "device"}, "expect": {"status": 200}, "save": {"C1": "code"}},
               {"op": "approve", "ref": "{C1}", "auth": "link_noscope", "body": {"actor": "chaz", "role": "owner"}, "expect": {"status": 403}},
               {"op": "approve", "ref": "{C1}", "auth": "grant_noscope", "body": {"actor": "chaz", "role": "owner"}, "expect": {"status": 403}},
               {"op": "deny", "ref": "{C1}", "auth": "link_noscope", "expect": {"status": 403}}]},
    {"id": "D20", "stage": "a paired screen approves a new device",
     "steps": [{"op": "request", "body": {"kind": "device", "name": "tv"}, "expect": {"status": 200}, "save": {"C1": "code", "S1": "secret"}},
               {"op": "approve", "ref": "{C1}", "auth": "link_device", "body": {}, "expect": {"status": 200, "json_subset": {"approved": true, "link": {"actor": "chaz", "role": "owner", "kind": "device"}}}},
               {"op": "poll", "ref": "{C1}", "secret": "{S1}", "expect": {"status": 200, "json_keys": ["token"]}}]},
    {"id": "deny", "stage": "deny pops the code; the poller is told once, then it is unknown",
     "steps": [{"op": "request", "body": {"kind": "device"}, "expect": {"status": 200}, "save": {"C1": "code", "S1": "secret"}},
               {"op": "deny", "ref": "{C1}", "auth": "grant", "expect": {"status": 200, "json_subset": {"denied": true}}},
               {"op": "poll", "ref": "{C1}", "secret": "{S1}", "expect": {"status": 403, "error": "denied"}},
               {"op": "poll", "ref": "{C1}", "secret": "{S1}", "expect": {"status": 404, "error": "unknown code"}},
               {"op": "approve", "ref": "{C1}", "auth": "grant", "body": {"actor": "chaz", "role": "owner"}, "expect": {"status": 404, "error": "no such code (expired?)"}}]},
    {"id": "P08", "stage": "an expired request is unknown to its poller, and pruned on the next request",
     "steps": [{"op": "request", "body": {"kind": "share"}, "expect": {"status": 200}, "save": {"PC": "code", "PS": "secret"}},
               {"op": "age", "seconds": 601},
               {"op": "request", "body": {"kind": "share", "name": "prune"}, "expect": {"status": 200}},
               {"op": "poll", "ref": "{PC}", "secret": "{PS}", "expect": {"status": 404, "error": "unknown code"}}]},
    {"id": "D18", "stage": "hash only: the raw token, secret and code appear nowhere in the ledgers",
     "steps": [{"op": "request", "body": {"kind": "device", "name": "x"}, "expect": {"status": 200}, "save": {"C1": "code", "S1": "secret"}},
               {"op": "approve", "ref": "{C1}", "auth": "grant", "body": {"actor": "chaz", "role": "owner"}, "expect": {"status": 200}},
               {"op": "poll", "ref": "{C1}", "secret": "{S1}", "expect": {"status": 200}, "save": {"TOKEN": "token"}},
               {"op": "prop", "name": "ledger-hash-only", "values": ["{TOKEN}", "{S1}", "{C1}"]}]},
    {"id": "X01", "stage": "the code alphabet is the Stage's, no vowels",
     "steps": [{"op": "prop", "name": "alphabet", "value": "BCDFGHJKLMNPQRSTVWXZ"}]}
  ]
}
