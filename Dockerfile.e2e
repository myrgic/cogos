# CogOS E2E Test — builds the binary and runs the full cold-start test.
#
# Usage:
#   docker build -f Dockerfile.e2e -t cogos-e2e-test .
#   docker run --rm cogos-e2e-test
#
# The container exits 0 if all tests pass, 1 on any failure.

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM golang:1.24-alpine AS builder

# CGO toolchain: go-sqlite3 compiles C, so the builder needs gcc + musl-dev.
RUN apk add --no-cache gcc musl-dev

ARG BUILD_TIME=e2e-test

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# CGO_ENABLED=1 + -tags fts5: the e2e binary must have a REAL sqlite driver.
# Under CGO_ENABLED=0, go-sqlite3 links a non-functional stub, so -tags fts5
# alone would not help — SearchMemory would fall through to the substring-grep
# path and the e2e suite, which now exercises cog_search_memory rather than
# only asserting its registration, would be testing a degraded binary.
#
# No -X ...engine.BuildTags here: that variable does not exist on this branch.
# It is introduced by #608, which also adds the /health build_tags report that
# consumes it. Injecting into an undeclared symbol is a silent no-op, so the
# flag would have looked like provenance and carried none.
RUN CGO_ENABLED=1 go build \
    -tags fts5 \
    -ldflags="-s -w -X github.com/myrgic/cogos/internal/engine.BuildTime=${BUILD_TIME}" \
    -o /cogos ./cmd/cogos

# ── Stage 2: Test ─────────────────────────────────────────────────────────────
FROM alpine:3.21

# libgcc: the CGO-linked binary needs it at runtime on alpine.
RUN apk add --no-cache bash curl git libgcc

COPY --from=builder /cogos /usr/local/bin/cogos
COPY scripts/e2e-test.sh /usr/local/bin/e2e-test.sh

ENV COGOS_BIN=/usr/local/bin/cogos
ENV E2E_WORKSPACE=/tmp/e2e-workspace
ENV E2E_PORT=5299

# Git needs a minimal config for salience scoring (git log).
RUN git config --global user.email "test@cogos.dev" && \
    git config --global user.name "CogOS E2E"

CMD ["e2e-test.sh"]
